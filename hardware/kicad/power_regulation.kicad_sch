	)
	(text "PG1..PG4 = REF (+ADJ); no PG capacitors. RT=VCC: 160..240ms.\nRST=RAILS_OK, isolated from SYS_HWRST.\nDo not substitute regulator PG; sense returns Kelvin to supervisor GND."
		(exclude_from_sim no)
		(at 23.8 561.34 0)
